# Copy this file to .env and fill in the settings you need.
# Never commit .env to git.

# --- Gemini access (set EITHER Vertex AI OR Google AI Studio) ---
# Option A: Vertex AI (required for Paper Query; recommended for large batches).
# Log in first with: gcloud auth application-default login
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Option B: Google AI Studio (used only when GOOGLE_CLOUD_PROJECT is unset)
# GOOGLE_API_KEY=your-gemini-api-key

# --- Paper Query only (Vertex AI batch job input/output bucket) ---
# GCS_BUCKET_NAME=your-gcs-bucket

# --- Optional: model overrides ---
# GEMINI_MODEL_NAME=gemini-3.1-pro-preview
# GEMINI_TARGET_MATCH_MODEL=gemini-3.8-flash

# --- Optional: citation verification APIs ---
# SEMANTIC_SCHOLAR_API_KEY=
# CROSSREF_MAILTO=you@example.org
# CROSSREF_API_TOKEN=
# API_RATE_DIVISOR=1

# --- Optional: local paths ---
# DATABASE_URL=sqlite:///data/compound_valet.db
# PUBCHEM_INDEX=data/pubchem/pubchem_offline.sqlite
# PUBCHEM_FLAT_DIR=data/pubchem/flat
